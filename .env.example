# ---------------------------------------------------------------------------
# ShareBeam configuration. Copy to `.env` and edit. Every value has a default,
# so an empty .env still boots a fully working server.
# ---------------------------------------------------------------------------

# --- HTTP server ------------------------------------------------------------
PORT=3000
HOST=0.0.0.0

# Public origin used when building share/room links and QR codes.
# Leave empty to derive it from the incoming request (works for LAN testing).
PUBLIC_URL=

# Set to 1 (or a hop count) when running behind nginx/Cloudflare/etc. so the
# X-Forwarded-For header is trusted. Mode 1 groups peers by public IP, so this
# MUST be correct behind a proxy or every visitor looks like the proxy itself.
TRUST_PROXY=0

# --- Limits (Mode 2 uploads) ------------------------------------------------
# Bytes. Default 2 GB per file. There is no cap on the number of files.
MAX_FILE_SIZE=2147483648
# Bytes. Total size of a single share (all files combined). Default 8 GB.
MAX_TOTAL_SIZE=8589934592
# Max characters for a shared text note.
MAX_TEXT_LENGTH=200000

# --- Expiry -----------------------------------------------------------------
# Allowed values: 1h, 6h, 24h, 3d, 7d
DEFAULT_EXPIRY=24h

# --- Storage (Mode 2 only; Modes 1 & 3 never touch disk) --------------------
STORAGE_DIR=data/uploads
# How often the TTL sweeper deletes expired shares, in seconds.
CLEANUP_INTERVAL=300

# --- Encryption at rest (AES-256-GCM) ---------------------------------------
# 64 hex characters (32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, a key is generated once and stored in MASTER_KEY_FILE.
MASTER_KEY=
MASTER_KEY_FILE=data/.masterkey

# --- Rooms (Mode 3) ---------------------------------------------------------
# How long an unused room link stays valid, in seconds. Default 12 hours.
ROOM_TTL=43200
ROOM_MAX_PARTICIPANTS=8

# --- Session/room state -----------------------------------------------------
# Optional. If set, link metadata is cached in Redis with a matching TTL.
# Leave empty to use the built-in in-memory store.
# REDIS_URL=redis://127.0.0.1:6379
REDIS_URL=

# --- WebRTC / NAT traversal -------------------------------------------------
# Comma-separated STUN URLs.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Comma-separated TURN URLs, used when direct P2P fails (symmetric NAT, some
# mobile carriers). See README "Adding a TURN server" for a coturn recipe.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
