{
  "name": "sharebeam",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Share files and text between devices: same-network auto discovery (P2P), expiring encrypted links, and bidirectional rooms (P2P). Runs entirely on Cloudflare Workers.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --test \"tests/*.test.js\"",
    "db:create": "wrangler d1 create sharebeam",
    "db:apply": "wrangler d1 execute sharebeam --remote --file=./schema.sql -y",
    "db:apply:local": "wrangler d1 execute sharebeam --local --file=./schema.sql -y",
    "r2:create": "wrangler r2 bucket create sharebeam-files",
    "tail": "wrangler tail"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "qrcode-generator": "^1.4.4"
  },
  "devDependencies": {
    "wrangler": "^4.20.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260801.1": true
  }
}
